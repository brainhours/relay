# --- Public URL where Uazapi will POST webhook events ---
PUBLIC_URL=https://your-tunnel.example.com

# --- Single-server form (simplest) ---
# Uncomment to use:
# UAZ_BASE_URL=https://free.uazapi.com
# UAZ_ADMIN_TOKEN=your-admin-token

# --- Multi-server form (preferred for production) ---
# JSON array of UazapiServerConfig. Each server is one Uazapi subscription.
# Fields: id, baseUrl, adminToken, capacity (optional), weight (optional),
#         enabled (optional, default true), tags (optional)
UAZ_SERVERS=[
  {"id":"plano-pequeno","baseUrl":"https://srv1.uazapi.com","adminToken":"tk1","capacity":2},
  {"id":"plano-medio",  "baseUrl":"https://srv2.uazapi.com","adminToken":"tk2","capacity":4},
  {"id":"plano-grande", "baseUrl":"https://srv3.uazapi.com","adminToken":"tk3","capacity":10}
]

# 'pinned' | 'round-robin' | 'weighted-round-robin' | 'least-loaded' | 'fill-first'
UAZ_STRATEGY=weighted-round-robin

# Optional shared secret appended to webhook URL for spoof protection
WEBHOOK_SECRET=change-me
