# --- Meta Cloud API credentials (per-tenant in real apps; here just demo env) ---

# WABA business account ID (numeric)
META_BUSINESS_ACCOUNT_ID=

# Phone number ID under the WABA (numeric)
META_PHONE_NUMBER_ID=

# System User permanent token (Meta Business Manager). Treat as secret.
META_ACCESS_TOKEN=

# App Secret (NOT the access token). Used to verify X-Hub-Signature-256 on
# inbound webhooks. Treat as secret.
META_APP_SECRET=

# String the app expects on the `hub.verify_token` query during the GET
# webhook handshake. You set this in the Meta app dashboard when
# subscribing the webhook.
WEBHOOK_VERIFY_TOKEN=

# --- Local server ---
PORT=3000

# Recipient for the demo /api/send-template endpoint (E.164 without +)
DEMO_TO=5511999999999

# Template name + language registered in your WABA (must be APPROVED)
DEMO_TEMPLATE_NAME=hello_world
DEMO_TEMPLATE_LANGUAGE=en_US
