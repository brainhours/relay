# --- Twilio credentials (per-tenant in real apps; here just demo env) ---

# Account SID (AC…) — found on the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=

# Auth Token — signs the X-Twilio-Signature on inbound webhooks AND is the
# Basic-auth password unless you use an API Key. Treat as secret.
TWILIO_AUTH_TOKEN=

# OPTIONAL: API Key pair (preferred in production — rotate/scope without
# touching the Auth Token). If set, these replace the Account SID + Auth Token
# for REST auth (the Auth Token is still needed for webhook validation).
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=

# --- Sender numbers ---

# Your Twilio number for SMS/MMS (E.164, e.g. +12025550123)
TWILIO_SMS_FROM=

# Your WhatsApp-enabled Twilio number (E.164; the demo adds the whatsapp: prefix).
# The Twilio sandbox number is +14155238886.
TWILIO_WHATSAPP_FROM=+14155238886

# OPTIONAL: use a Messaging Service (MG…) instead of a fixed from-number.
# TWILIO_MESSAGING_SERVICE_SID=

# --- Twilio Connect (OAuth-style onboarding) ---

# OPTIONAL: your Connect App SID (CN…). Set this to enable the /twilio/connect/*
# routes. Configure the Connect App's "Authorize URL" to point at
# https://<your-tunnel>/twilio/connect/callback. With Connect you send on a
# customer's behalf using their connected AccountSid + your master TWILIO_AUTH_TOKEN.
# TWILIO_CONNECT_APP_SID=

# --- Local server ---
PORT=3000

# Recipient for the demo /api/send endpoints (E.164 with +)
DEMO_TO=+5511999999999
