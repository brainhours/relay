# Configuração de npm do projeto.
#
# NUNCA coloque credenciais aqui: este arquivo é versionado e o repositório é
# público. Um PAT já foi commitado neste arquivo uma vez e acabou revogado pelo
# secret scanning do GitHub.
#
# Autenticação para publicar vive fora do repo:
#   - local: `npm login` grava em ~/.npmrc (global do usuário)
#   - CI:    variável NODE_AUTH_TOKEN, via secret do GitHub Actions
#
# O pacote é publicado no registry público (npmjs.org), então instalar não
# exige autenticação nenhuma.

save-exact=true
engine-strict=true
