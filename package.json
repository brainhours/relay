{
  "name": "relay",
  "version": "0.0.0",
  "private": true,
  "description": "Unified messaging integrations for Node.js applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermegoulart1/relay.git"
  },
  "keywords": [
    "messaging",
    "unipile",
    "twilio",
    "whatsapp",
    "linkedin",
    "webhooks",
    "integrations",
    "multi-channel"
  ],
  "author": "Guilherme Goulart <guilherme@leadraze.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/guilhermegoulart1/relay/issues"
  },
  "homepage": "https://github.com/guilhermegoulart1/relay#readme",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "echo \"Tests pending\"",
    "lint": "eslint packages/*/src --ext .js",
    "lint:fix": "eslint packages/*/src --ext .js --fix",
    "clean": "rm -rf packages/*/node_modules packages/*/dist node_modules",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
