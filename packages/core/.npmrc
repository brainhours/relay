# Configuração de npm deste pacote.
#
# NUNCA coloque credenciais aqui: este arquivo é versionado e o repositório é
# público. Um PAT já foi commitado aqui (e no .npmrc da raiz) uma vez, e acabou
# revogado pelo secret scanning do GitHub.
#
# Autenticação para publicar vive fora do repo:
#   - local: `npm login` grava em ~/.npmrc (global do usuário)
#   - CI:    variável NODE_AUTH_TOKEN, via secret do GitHub Actions
#
# O registry de publicação é o npmjs.org (default), definido por
# publishConfig.access no package.json.

save-exact=true
engine-strict=true
