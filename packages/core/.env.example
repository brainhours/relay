# ===========================================
# Relay Core - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# -------------------------------------------
# UNIPILE PROVIDER (Required)
# -------------------------------------------
# Get these from: https://app.unipile.com > Settings > API

# Your Unipile DSN (e.g., api1.unipile.com:13111)
UNIPILE_DSN=

# Your Unipile Access Token
UNIPILE_ACCESS_TOKEN=

# Alternative name (use either ACCESS_TOKEN or API_KEY)
# UNIPILE_API_KEY=

# -------------------------------------------
# REDIS (Optional - for queue integration)
# -------------------------------------------
# Required only if using Bull queue for webhook processing

REDIS_URL=redis://localhost:6379

# -------------------------------------------
# WEBHOOK CONFIGURATION (Optional)
# -------------------------------------------
# Used for webhook URL generation

BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# -------------------------------------------
# LOGGING (Optional)
# -------------------------------------------

LOG_LEVEL=info
DEBUG=relay:*
